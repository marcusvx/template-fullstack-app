{
  "name": "template-app",
  "version": "1.0.0",
  "private": true,
  "license": "UNLICENSED",
  "workspaces": [
    "apps/*"
  ],
  "overrides": {
    "brace-expansion": "5.0.8",
    "minimatch": "10.2.5",
    "glob": "13.0.6",
    "fork-ts-checker-webpack-plugin": {
      "minimatch": "10.2.5"
    },
    "test-exclude": {
      "glob": "13.0.6",
      "minimatch": "10.2.5"
    },
    "@jest/reporters": {
      "glob": "13.0.6"
    },
    "jest-config": {
      "glob": "13.0.6"
    },
    "jest-runtime": {
      "glob": "13.0.6"
    }
  },
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm run start:dev --workspace @template/backend",
    "dev:frontend": "npm run dev --workspace @template/frontend",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspace @template/backend",
    "lint": "npm run lint --workspaces --if-present",
    "docker:up": "docker compose up --build -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f backend"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^10.0.4",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.7.0",
    "prettier": "^3.9.6",
    "typescript-eslint": "^8.65.0"
  }
}
