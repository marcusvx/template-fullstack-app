{
  "name": "template-app",
  "version": "1.0.0",
  "private": true,
  "license": "UNLICENSED",
  "workspaces": [
    "apps/*"
  ],
  "overrides": {
    "brace-expansion": "5.0.9"
  },
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm run start:dev --workspace @template/backend",
    "dev:frontend": "npm run dev --workspace @template/frontend",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspace @template/backend",
    "test:e2e": "npm run test:e2e --workspace @template/backend",
    "lint": "npm run lint --workspaces --if-present",
    "verify": "npm run lint && npm run build && npm run test",
    "docker:up": "docker compose up --build -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f backend"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^10.0.5",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "typescript-eslint": "^8.67.0"
  }
}
